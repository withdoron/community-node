{
  "name": "FSEstimate",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "FK to FieldServiceProfile"
    },
    "user_id": {
      "type": "string",
      "description": "FK to Users entity"
    },
    "project_id": {
      "type": "string",
      "description": "FK to FSProject (optional)"
    },
    "client_id": {
      "type": "string",
      "description": "FK to FSClient (optional)"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "client_address": {
      "type": "string"
    },
    "estimate_number": {
      "type": "string",
      "description": "e.g. EST-2026-001"
    },
    "title": {
      "type": "string",
      "description": "Project title for the estimate"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "awaiting_signature",
        "signed",
        "accepted",
        "declined",
        "expired"
      ],
      "description": "Estimate status. awaiting_signature + signed added 2026-04-29 to match the signing-flow code."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "ISO date"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "ISO date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "line_items": {
      "type": "object",
      "description": "Array of {description, quantity, unit, unit_cost, total}"
    },
    "labor_estimate": {
      "type": "object",
      "description": "{hours, rate, total}"
    },
    "subtotal": {
      "type": "number"
    },
    "overhead_profit_pct": {
      "type": "number",
      "default": 0,
      "description": "Overhead & profit percentage applied to subtotal"
    },
    "management_fee_pct": {
      "type": "number",
      "default": 0,
      "description": "Management fee percentage applied to subtotal"
    },
    "insurance_fee_pct": {
      "type": "number",
      "default": 0,
      "description": "Insurance fee percentage applied to subtotal. Calculates against subtotal-only (does not stack on Management Fee or O&P). Manually entered by the contractor based on their annual insurance allocation."
    },
    "insurance_fee_amount": {
      "type": "number",
      "description": "Calculated insurance fee amount. Derived from subtotal \u00d7 insurance_fee_pct."
    },
    "tax_rate": {
      "type": "number",
      "default": 0,
      "description": "Tax rate percentage. Canonical (consolidated 2026-04-29 \u2014 tax_rate_pct removed; the codebase has always written tax_rate)."
    },
    "tax_amount": {
      "type": "number"
    },
    "other_amount": {
      "type": "number",
      "default": 0,
      "description": "Miscellaneous additional amount"
    },
    "total": {
      "type": "number"
    },
    "payment_terms": {
      "type": "string",
      "description": "Payment terms (e.g. Net 30, 50% upfront)"
    },
    "terms": {
      "type": "string"
    },
    "conditions": {
      "type": "string",
      "description": "Specific conditions or contingencies for this estimate"
    },
    "notes": {
      "type": "string"
    },
    "prepared_by": {
      "type": "string",
      "description": "Name of the person who prepared the estimate"
    },
    "group_by_trade": {
      "type": "boolean",
      "default": false,
      "description": "When true, line items render grouped by trade with per-trade subtotals plus an Unallocated bucket for line items without a trade tag. When false, line items render as a single flat table. Renamed from flat_layout on 2026-05-08 with semantic inversion as part of Phase 2.2. Default value preserved at false; values will be inverted by Phase 2.2 migration script #1 after rename."
    },
    "taxonomy_preset_id": {
      "type": "string",
      "description": "Slug of the taxonomy preset this estimate uses. Valid values: general_contractor, csi_masterformat, simple_three_bucket, service_provider_hourly, or null on legacy estimates pre-Phase 2.2. Defaults from FieldServiceProfile.default_taxonomy_preset_id at estimate creation."
    },
    "trade_categories_snapshot": {
      "type": "object",
      "description": "Frozen array of trade category objects at preset-pick time. Shape: [{ id, name, order }, ...]. Always written as resolved array shape \u2014 never the legacy { items: [...] } wrap. Renders authoritatively for this estimate; workspace's trade_categories_json is fallback only when this is null (legacy estimates pre-Phase 2.2 backfill migration). Declared as object to match existing trade_categories_json declaration pattern."
    },
    "show_csi_codes": {
      "type": "boolean",
      "default": false,
      "description": "Per-estimate toggle for displaying CSI division codes on rendered estimate. Architecture-open for Phase 2 \u00a713 Q4 future render path. Field exists; render path NOT built in Phase 2.2."
    },
    "client_show_breakdown": {
      "type": "boolean",
      "default": false,
      "description": "When true, the estimate preview shows materials and labor as separate line items. When false, only the total is shown."
    },
    "sent_at": {
      "type": "string",
      "description": "ISO datetime"
    },
    "viewed_at": {
      "type": "string",
      "description": "ISO datetime"
    },
    "responded_at": {
      "type": "string",
      "description": "ISO datetime"
    },
    "portal_token": {
      "type": "string",
      "description": "Unique token for client signing/viewing link"
    },
    "portal_link_active": {
      "type": "boolean",
      "description": "Whether the link is currently valid"
    },
    "sent_for_signature_at": {
      "type": "string",
      "description": "ISO datetime when sent for signature"
    },
    "recalled_at": {
      "type": "string",
      "description": "ISO datetime if recalled"
    },
    "signed_at": {
      "type": "string",
      "description": "ISO datetime when client signed"
    },
    "owner_signature_data": {
      "type": "string",
      "description": "JSON string with owner's signature details"
    },
    "owner_signed_at": {
      "type": "string",
      "description": "ISO datetime when owner signed"
    },
    "business_id": {
      "type": "string",
      "description": "FK to a Business record. Scopes this record to a specific business inside the new multi-business architecture. Will be backfilled in a separate Hyphae script. Code continues to work with business_id: null (dual-read pattern during backfill)."
    }
  },
  "required": [
    "profile_id",
    "user_id",
    "client_name",
    "title",
    "status",
    "line_items"
  ],
  "security": {
    "read": {
      "authenticated": true
    },
    "create": {
      "owner": true
    },
    "update": {
      "owner": true
    },
    "delete": {
      "owner": true
    }
  },
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}