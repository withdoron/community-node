{
  "name": "FSChangeOrder",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "FK to FSProject"
    },
    "estimate_id": {
      "type": "string",
      "description": "FK to FSEstimate (optional)"
    },
    "user_id": {
      "type": "string",
      "description": "FK to Users entity"
    },
    "workspace_id": {
      "type": "string",
      "description": "FK to FieldServiceProfile"
    },
    "change_order_number": {
      "type": "string",
      "description": "Sequential change order number per project. Format: 'CO-001', 'CO-002', etc. Auto-incremented on creation by the application layer. Maps to co_number in the spec."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Narrative explanation of what this change order covers and why."
    },
    "line_items": {
      "type": "object",
      "default": {},
      "description": "Array of line item objects"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "amount": {
      "type": "number",
      "description": "Net contract adjustment for this change order. Full grand total (line items + O&P + tax + other_amount). Used by FSProject.total_budget recompute logic."
    },
    "overhead_profit_pct": {
      "type": "number",
      "default": 0,
      "description": "Overhead and profit percentage applied to the line-items subtotal. Mirrors FSEstimate.overhead_profit_pct. The CO builder pre-fills this from the parent FSEstimate on CO creation; the contractor can override per CO."
    },
    "tax_rate": {
      "type": "number",
      "default": 0,
      "description": "Tax rate percentage applied after O&P and other_amount are added. Mirrors FSEstimate.tax_rate."
    },
    "tax_amount": {
      "type": "number",
      "default": 0,
      "description": "Computed tax dollar amount based on tax_rate and the taxable base. Mirrors FSEstimate.tax_amount."
    },
    "other_amount": {
      "type": "number",
      "default": 0,
      "description": "Flat dollar addition before tax. Mirrors FSEstimate.other_amount."
    },
    "insurance_fee_pct": {
      "type": "number",
      "default": 0,
      "description": "Insurance fee percentage applied to subtotal. Calculates against subtotal-only (does not stack on Management Fee or O&P). Manually entered by the contractor based on their annual insurance allocation."
    },
    "insurance_fee_amount": {
      "type": "number",
      "description": "Calculated insurance fee amount. Derived from subtotal \u00d7 insurance_fee_pct."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "awaiting_signature",
        "signed",
        "declined"
      ],
      "default": "draft",
      "description": "The lifecycle state of this change order. Mirrors FSEstimate.status pattern. Transitions: draft \u2192 sent \u2192 awaiting_signature \u2192 signed | declined. Legacy 'accepted' value preserved for existing records."
    },
    "accepted_date": {
      "type": "string",
      "format": "date",
      "description": "ISO date when change order was accepted (legacy field)"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the client signed this change order. Set when status transitions to 'signed'. Null otherwise."
    },
    "signature_data": {
      "type": "string",
      "description": "JSON.stringify'd signature blob (per existing FSDocument pattern). Stored as text. Null until signing completes."
    },
    "portal_token": {
      "type": "string",
      "description": "Unique token validating client portal access for CO signing. Generated by the application when a CO is sent for signature. Validated server-side by the signChangeOrder function before any update."
    },
    "portal_link_active": {
      "type": "boolean",
      "description": "Whether the signing link is currently valid. Set to true when CO is sent for signature, false when recalled or after signing completes."
    },
    "sent_for_signature_at": {
      "type": "string",
      "description": "ISO datetime when the CO was sent for signature. Set alongside status transitioning to 'awaiting_signature'."
    },
    "recalled_at": {
      "type": "string",
      "description": "ISO datetime when the CO was recalled (status returned from awaiting_signature back to draft)."
    }
  },
  "required": [
    "project_id",
    "user_id",
    "workspace_id",
    "title",
    "status"
  ],
  "security": {
    "read": true,
    "create": {
      "owner": true
    },
    "update": true,
    "delete": {
      "owner": true
    }
  },
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}