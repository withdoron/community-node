{
  "name": "FSPayment",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "FK to FieldServiceProfile"
    },
    "user_id": {
      "type": "string",
      "description": "FK to Users entity"
    },
    "project_id": {
      "type": "string",
      "description": "FK to FSProject"
    },
    "type": {
      "type": "string",
      "enum": [
        "deposit",
        "progress_payment",
        "final_payment",
        "change_order",
        "refund"
      ],
      "description": "Payment type"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "ISO date"
    },
    "direction": {
      "type": "string",
      "enum": [
        "received",
        "paid"
      ],
      "default": "received",
      "description": "Indicates whether this payment was received from a party (e.g. client) or paid out to a party (e.g. subcontractor, vendor)."
    },
    "party_type": {
      "type": "string",
      "enum": [
        "client",
        "subcontractor",
        "vendor",
        "other"
      ],
      "default": "client",
      "description": "The type of party involved in this payment."
    },
    "party_name": {
      "type": "string",
      "description": "Display name of the party. Denormalized for portability \u2014 even when party is a one-off vendor without an FSClient record."
    },
    "party_id": {
      "type": "string",
      "description": "FK reference. When party_type is 'client', references FSClient.id. When party_type is 'subcontractor' or 'vendor', references the id of the matching item inside the linked FieldServiceProfile.workers_json blob (Phase 2.4 SubVendorPicker write target). Null for 'other' or one-off cases. Field-type unchanged; semantic broadened."
    },
    "method": {
      "type": "string",
      "enum": [
        "cash",
        "check",
        "card",
        "transfer",
        "ach",
        "other"
      ],
      "description": "Payment method used."
    },
    "check_number": {
      "type": "string"
    },
    "reference": {
      "type": "string",
      "description": "Reference identifier (check number, ACH transaction ID, etc.)"
    },
    "notes": {
      "type": "string",
      "description": "Free-form notes about this payment."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "received",
        "cleared"
      ],
      "description": "Payment status"
    },
    "line_item_id": {
      "type": "string",
      "description": "Nullable. FK to a line item ID inside the project's FSEstimate.line_items or any signed FSChangeOrder.line_items. No FK enforcement at entity layer (line items live as JSON inside the parent estimate/CO; FK is application-level). When null, payment is 'unallocated' \u2014 flows into the project-level Unallocated bucket."
    },
    "parent_payment_id": {
      "type": "string",
      "description": "Nullable. FK to another FSPayment record. Used by the cleared-payment Reverse flow \u2014 a reversing payment carries the original payment's ID here. Original record stays intact; net to zero."
    },
    "deleted_at": {
      "type": "string",
      "description": "Nullable datetime. Stamps when the record was soft-deleted via the softDeleteWithCascade server function. Null means the record is live. Excluded from default reads via .filter() chains in code."
    },
    "deleted_by": {
      "type": "string",
      "description": "Nullable. User ID (the Users.id value) of the user who soft-deleted the record. Captured for audit trail."
    },
    "business_id": {
      "type": "string",
      "description": "FK to a Business record. Scopes this record to a specific business inside the new multi-business architecture. Will be backfilled in a separate Hyphae script. Code continues to work with business_id: null (dual-read pattern during backfill)."
    }
  },
  "required": [
    "profile_id",
    "user_id",
    "project_id",
    "type",
    "amount",
    "date",
    "status"
  ],
  "security": {
    "read": true,
    "create": {
      "owner": true
    },
    "update": {
      "owner": true
    },
    "delete": {
      "owner": true
    }
  },
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}